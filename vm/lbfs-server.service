[Unit]
Description=lbfs server
After=network.target

# The rate bound on Restart=on-failure. Since systemd 229 these two live in
# [Unit], not [Service]. Five failures inside a minute is a server that cannot
# start at all — a bad config, a taken port — and restarting it forever would
# only bury the reason in the journal. Past the burst systemd gives up and
# leaves the unit failed, which is what the deploy gate and the operator can
# both see.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=/usr/local/bin/lbfs-server --config /etc/lbfs.toml
# A server that dies takes the export with it: an io_uring lane that loses its
# ring now aborts the process rather than answer EIO forever, and that is only
# the right trade if something puts the process back.
Restart=on-failure
RestartSec=1
User=ubuntu

# The server holds one O_PATH descriptor per node a client still remembers, so
# this number is the largest tree a client may have live at once. It raises its
# own soft limit to the hard one at startup, which is what makes it correct
# under any launcher; this sets the hard limit that raise aims at, because
# systemd's default of 524288 is a policy decision the unit should make rather
# than inherit. Belt and braces: either mechanism alone clears a build tree.
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
